PORT=4000
FRONTEND_URL=http://localhost:5173

# Required by the API to authenticate requests and save private workspace data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: required only for server-side contact form storage.
SUPABASE_SERVICE_ROLE_KEY=

# Required by the server-side business analyst chat. Never use a VITE_ prefix.
ANTHROPIC_API_KEY=
# Optional model override for the Anthropic Messages API.
ANTHROPIC_MODEL=

# Frontend Supabase Auth configuration. The anon key is public; never put the
# service role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set this in the Vercel project to point the frontend at the Render API.
# VITE_API_BASE_URL=https://your-api.onrender.com
